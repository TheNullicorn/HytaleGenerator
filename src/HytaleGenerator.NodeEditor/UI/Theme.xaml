<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Viewport background style. -->
    <SolidColorBrush x:Key="Viewport.Body.Fill" Color="#33343b" />

    <!-- Selection rectangle style. -->
    <SolidColorBrush x:Key="Viewport.Selection.Fill" Color="#3c8bc8" Opacity="0.5" />
    <SolidColorBrush x:Key="Viewport.Selection.Border" Color="#3c8bc8" Opacity="0.9" />
    <Style x:Key="Viewport.Selection.Style" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Viewport.Selection.Fill}" />
        <Setter Property="Stroke" Value="{StaticResource Viewport.Selection.Border}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
    </Style>
    
    <!-- Node style. -->
    <SolidColorBrush x:Key="Node.Body.Fill" Color="#575a5e" />
</ResourceDictionary>